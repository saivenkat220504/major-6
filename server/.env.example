# ==========================================
# BACKEND SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Server listening port
PORT=4000

# PostgreSQL Database Connection String (Prisma ORM)
# Example local: postgresql://postgres:password@localhost:5432/smart_airport?schema=public
# Example cloud: postgresql://user:pass@ep-xyz.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/smart_airport?schema=public"

# JWT Authentication Secret
JWT_SECRET="your_jwt_secret_dev_key_change_in_production"

# Telegram Bot Integration (Live Driver & Emergency Chat)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# AI & LLM Engine (OpenAI / OpenRouter API Key)
LLM_API="sk-or-v1-your-api-key-here"

# Real-time Web Search Provider
SERPER_API_KEY="your_serper_api_key_here"

# Gmail SMTP for Email Alerts & OTP Verification
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-google-app-password"
